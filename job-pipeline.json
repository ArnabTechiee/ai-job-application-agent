    {
      "parameters": {
        "jsCode": "const strip = (h) => (h || '')\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/&nbsp;|&amp;|&#\\d+;/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst badTitle = /senior|sr\\.|lead|manager|principal|director|staff|head of|architect/i;\nconst badExp = /\\b([3-9]|1\\d)\\+?\\s*(years|yrs)\\b/i;\nconst okRemoteLocation = /worldwide|anywhere|india|asia|apac|global/i;\n\nreturn $input.all()\n  .map(i => ({\n    json: {\n      ...i.json,\n      description: strip(i.json.description).slice(0, 4000),\n    },\n  }))\n  .filter(({ json: j }) => {\n    if (badTitle.test(j.title || '')) return false;\n    if (badExp.test(j.description)) return false;\n    if (j.source === 'remotive' && j.location && !okRemoteLocation.test(j.location)) return false;\n    return true;\n  });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
